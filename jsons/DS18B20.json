{
  "device": "DS18B20 Multisensor",
  "_note": "Tasmota-Gerät mit bis zu 6x DS18B20 + BME280. Topic-Prefix anpassen: XXXXXX → Tasmota-Gerätename (Tasmota → Configuration → MQTT → Topic). WICHTIG zur Sensor-Zuordnung: Die Position 'DS18B20-1'..'DS18B20-6' vergibt Tasmota nach Erkennungsreihenfolge – die kann sich ändern, dann wären die Messwerte vertauscht. Stabil ist die Sensor-'Id'. Diese Vorlage nutzt daher value_json_byid('<Id>') – trage die echte Id jedes Sensors ein (steht im SENSOR-Payload: {\"DS18B20-1\":{\"Id\":\"000000AF9C70\",\"Temperature\":19.5}}). Alternativ (nicht empfohlen) positionsbasiert: value_json['DS18B20-1'].Temperature. Nicht benötigte Channels nach dem Import löschen.",
  "channels": [

    {
      "name": "Status",
      "note": "LWT: 1=online, 0=offline",
      "subscribeTopic": "tele/XXXXXX/LWT",
      "dataType": "int",
      "valueMapIn": {"Online": "1", "Offline": "0"},
      "direction": "subscribe"
    },

    {
      "name": "Temperatur Sensor A",
      "note": "Id durch echte Sensor-Id ersetzen (aus SENSOR-Payload, Feld 'Id'). Stabil unabhängig von der DS18B20-N-Reihenfolge.",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json_byid('000000AF9C70').Temperature | round(1) }}",
      "unit": "°C",
      "direction": "subscribe"
    },

    {
      "name": "Temperatur Sensor B",
      "note": "Id durch echte Sensor-Id ersetzen.",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json_byid('000000B12345').Temperature | round(1) }}",
      "unit": "°C",
      "direction": "subscribe"
    },

    {
      "name": "Temperatur Sensor C",
      "note": "Id durch echte Sensor-Id ersetzen.",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json_byid('SENSOR_ID_C').Temperature | round(1) }}",
      "unit": "°C",
      "direction": "subscribe"
    },

    {
      "name": "Temperatur Sensor D",
      "note": "Id durch echte Sensor-Id ersetzen.",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json_byid('SENSOR_ID_D').Temperature | round(1) }}",
      "unit": "°C",
      "direction": "subscribe"
    },

    {
      "name": "Temperatur Sensor E",
      "note": "Id durch echte Sensor-Id ersetzen.",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json_byid('SENSOR_ID_E').Temperature | round(1) }}",
      "unit": "°C",
      "direction": "subscribe"
    },

    {
      "name": "Temperatur Sensor F",
      "note": "Id durch echte Sensor-Id ersetzen.",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json_byid('SENSOR_ID_F').Temperature | round(1) }}",
      "unit": "°C",
      "direction": "subscribe"
    },

    {
      "name": "BME280 Temperatur",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json.BME280.Temperature | round(1) }}",
      "unit": "°C",
      "direction": "subscribe"
    },

    {
      "name": "BME280 Luftfeuchtigkeit",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json.BME280.Humidity | round(1) }}",
      "unit": "%",
      "direction": "subscribe"
    },

    {
      "name": "BME280 Luftdruck",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json.BME280.Pressure | round(1) }}",
      "unit": "hPa",
      "direction": "subscribe"
    },

    {
      "name": "BME280 Taupunkt",
      "subscribeTopic": "tele/XXXXXX/SENSOR",
      "dataType": "float",
      "valueTemplate": "{{ value_json.BME280.DewPoint | round(1) }}",
      "unit": "°C",
      "direction": "subscribe"
    }

  ]
}
