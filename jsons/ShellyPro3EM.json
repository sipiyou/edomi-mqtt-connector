      "subscribeTopic": "shellyproem3-XXXXXX/status/em:0",
      "dataType": "float",
      "jsonPath": "b_current",
      "direction": "subscribe",
      "unit": "A",
      "note": "Strom Phase L2"
    },
    {
      "name": "L2 Wirkleistung W",
      "subscribeTopic": "shellyproem3-XXXXXX/status/em:0",
