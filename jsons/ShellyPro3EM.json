{
  "device": "Shelly Pro 3EM",
  "_note": "VORAUSSETZUNG: status_ntf am Shelly aktivieren (einmalig): http://SHELLY-IP/rpc/MQTT.SetConfig?config={\"status_ntf\":true} — ohne diese Einstellung werden status/em:0 und status/emdata:0 NICHT publiziert (Shelly Gen2 Default ist events/rpc mit Wrapper-JSON). Topic-Prefix ersetzen: shellyproem3-XXXXXX → eigene Geräte-ID (z.B. shellyproem3-AABBCC). Geräte-ID: Shelly Weboberfläche → Einstellungen → Gerätename. MQTT-Prefix: Gen2-Standard ohne 'shellies/'-Präfix. Energiewerte in emdata:0 sind in Wh, Template rechnet in kWh um.",
  "channels": [
    {
      "name": "L1 Spannung V",
      "subscribeTopic": "shellyproem3-XXXXXX/status/em:0",
      "dataType": "float",
      "jsonPath": "a_voltage",
      "direction": "subscribe",
      "unit": "V",
      "note": "Spannung Phase L1"
    },
    {
      "name": "L1 Strom A",
      "subscribeTopic": "shellyproem3-XXXXXX/status/em:0",
      "dataType": "float",
      "jsonPath": "a_current",
      "direction": "subscribe",
      "unit": "A",
      "note": "Strom Phase L1"
    },
    {
      "name": "L1 Wirkleistung W",
      "subscribeTopic": "shellyproem3-XXXXXX/status/em:0",
      "dataType": "float",
      "jsonPath": "a_act_power",
      "direction": "subscribe",
      "unit": "W",
      "note": "Wirkleistung Phase L1 (negativ = Einspeisung)"
    },
    {
      "name": "L1 Scheinleistung VA",
      "subscribeTopic": "shellyproem3-XXXXXX/status/em:0",
      "dataType": "float",
      "jsonPath": "a_aprt_power",
      "direction": "subscribe",
      "unit": "VA",
      "note": "Scheinleistung Phase L1"
    },
    {
      "name": "L1 Leistungsfaktor",
      "subscribeTopic": "shellyproem3-XXXXXX/status/em:0",
      "dataType": "float",
      "jsonPath": "a_pf",
      "direction": "subscribe",
      "note": "Leistungsfaktor Phase L1 (0..1)"
    },
    {
      "name": "L2 Spannung V",
      "subscribeTopic": "shellyproem3-XXXXXX/status/em:0",
